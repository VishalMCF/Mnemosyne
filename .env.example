# Local SQLite database path. Relative paths resolve from the repository root.
DATABASE_URL=./data/database/mnemosyne.sqlite

# Uses the existing Codex ChatGPT login; no API key is required.
CODEX_MODEL=gpt-5.6-sol
# Optional absolute executable path if codex is not on the server PATH.
# CODEX_BIN=/path/to/codex
